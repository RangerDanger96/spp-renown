###################################################################################################################
# RENOWN SETTINGS
#
#    Warhammer-style PvP progression. Renown is earned from player kills, battleground objectives and
#    battleground results. Ranks never decay and are saved per character.
#
#    Renown.Enable
#        Enable the Renown system
#        Default: 1 (enable)
#                 0 (disable)
#
#    Renown.Bots
#        Allow bots to earn Renown (bots rank up silently and receive no insignias)
#        Default: 1
#
#    Renown.MaxRank
#        Highest Renown rank
#        Default: 40
#
#    Renown.RankBase
#    Renown.RankExponent
#        Total renown needed for rank R = RankBase * (R - 1) ^ RankExponent
#        Defaults (100 / 1.5): rank 5 = 800, rank 10 = 2700, rank 20 = 8282, rank 30 = 15617, rank 40 = 24355
#
#    Renown.Rate
#        Multiplier applied to all renown gains
#        Default: 1.0
#
#    Renown.AnnounceEvery
#        Server-wide announcement every N ranks (real players only). 0 = never
#        Default: 5
#
#    Renown.Bolster
#        Inside a battleground, raise players below the top level of their bracket to that level's base
#        stats, health and mana (1-9 -> 9, 10-19 -> 19, ... 50-59 -> 59, Alterac Valley -> 60).
#        Spells and talents are not changed. Removed when leaving the battleground.
#        Default: 1
#
#    Renown.LootBags
#        At the end of a battleground the top contributors (by Renown earned in that match, with a small random
#        factor) win loot bags. Winners: 1st Gold, 2nd-3rd Purple, 4th-6th Blue. Losers: 1st Purple, 2nd-3rd Blue.
#        Bags give Renown points and a chance at gear from the Renown rewards that fits the player's class, level
#        and Renown tier. Bots take part in the ranking but only players receive bags.
#        Default: 1
#
#    Renown.LootBags.GoldPoints / PurplePoints / BluePoints            Renown points in each bag
#    Renown.LootBags.GoldItemChance / PurpleItemChance / BlueItemChance  Chance (%) the bag also holds gear
#
#    Renown.Streaks
#        Kill streaks: from 3 kills without dying each kill gives BonusPerKill x streak extra Renown (max BonusMax).
#        Streaks are announced to the zone / battleground.
#        Default: 1
#
#    Renown.Bounty.MinStreak / PerKill / Max
#        Killing a player on a streak of MinStreak or more pays a bounty of PerKill x streak Renown (max Max).
#
#    Renown.Points.HealAssist
#        Renown for each healer who healed one of the attackers within Renown.AssistWindow seconds before an
#        enemy player died.
#
#    Renown.RvR.Enable
#        The Barrens Front: a tier 1 RvR lake between the Crossroads (Horde) and Northwatch Hold (Alliance).
#        Three objectives (Kolkar Watch, Stagnant Oasis, Raptor Grounds); hold all three for SiegeHold seconds to
#        open a siege on the enemy commander; killing the commander locks the lake for LockMinutes.
#        Inside the lake players are bolstered to MaxLevel and anyone above MaxLevel is turned into a chicken.
#        Commands: .renown rvr join | leave | status    .renown queue wsg | ab | av  (queue from anywhere)
#        Default: 1
#
#    Renown.RvR.MaxLevel        Tier cap (default 19)
#    Renown.RvR.CaptureTime     Seconds of uncontested presence to capture an objective (default 20)
#    Renown.RvR.CaptureRadius   Yards (default 25)
#    Renown.RvR.CapturePoints   Renown for each player who helps capture (default 40)
#    Renown.RvR.TickPoints      Renown per owned objective every minute to each player of that side in the lake (default 5)
#    Renown.RvR.DefendPoints    Extra Renown for killing an enemy near an objective your side holds (default 10)
#    Renown.RvR.SiegeHold       Seconds a side must hold all objectives before the siege opens (default 120)
#    Renown.RvR.LockMinutes     How long the lake stays locked after a successful siege (default 20)
#    Renown.RvR.BotShare        Percent of each faction's level 1-19 bots that fight on the front (default 80, 0 = off).
#                               The same bots every time (picked by guid); idle ones are sent back in waves.
#    Renown.RvR.BotsPerWave     Bots sent per faction every 30 seconds (default 15)
#    Renown.RvR.BotsPerSide     Optional cap on front bots per faction (default 0 = no cap)
#
#    Renown.FieldMount.Enable   Levels 1-MaxLevel can summon their racial mount at Speed % (.renown mount, Mount button)
#    Renown.FieldMount.Bots     Low-level bots traveling in the Barrens mount up automatically
#    Renown.FieldMount.Speed    Default 30
#    Renown.FieldMount.MaxLevel Default 39
#
#    Renown.Points.*
#        Renown awarded per event
#
#    Renown.InsigniaRanks / Renown.InsigniaItems
#        Comma-separated lists of equal length. Reaching a rank gives the matching insignia item, which
#        unlocks a tier of rewards at the Battleground Quartermaster.
#
#    Renown.Quartermasters
#        Creature entries that show the player's renown and hand out missing insignias when talked to
#
#    Commands:
#        .renown info [name]        Show renown rank and progress (yours, your target's or a named player's)
#        .renown top                Top 10 characters by renown
#        .renown sync               Silently refresh the RenownBar addon
#        .renown add <points> [name]  (GM) Add or remove renown
#        .renown set <rank> [name]    (GM) Set a renown rank
#        .renown give <points> [name] (GM) Add or remove spendable Renown points (rank unchanged)
#        .renown reload               (Admin) Reload Renown vendor prices from custom_renown_vendor
#
#    Renown points are also a currency: items listed in the world table custom_renown_vendor cost that many
#    spendable Renown points instead of gold (zz_renown.sql fills it for the Battleground Quartermasters).
#
###################################################################################################################

Renown.Enable = 1
Renown.Bots = 1
Renown.MaxRank = 40
Renown.RankBase = 100
Renown.RankExponent = 1.5
Renown.Rate = 1.0
Renown.AnnounceEvery = 5
Renown.Bolster = 1

Renown.LootBags = 1
Renown.LootBags.GoldPoints = 100
Renown.LootBags.PurplePoints = 60
Renown.LootBags.BluePoints = 30
Renown.LootBags.GoldItemChance = 100
Renown.LootBags.PurpleItemChance = 50
Renown.LootBags.BlueItemChance = 25

Renown.Streaks = 1
Renown.Streaks.BonusPerKill = 2
Renown.Streaks.BonusMax = 30
Renown.Bounty.MinStreak = 5
Renown.Bounty.PerKill = 10
Renown.Bounty.Max = 250
Renown.AssistWindow = 15

Renown.RvR.Enable = 1
Renown.RvR.MaxLevel = 19
Renown.RvR.CaptureTime = 20
Renown.RvR.CaptureRadius = 25
Renown.RvR.CapturePoints = 40
Renown.RvR.TickPoints = 5
Renown.RvR.DefendPoints = 10
Renown.RvR.SiegeHold = 120
Renown.RvR.LockMinutes = 20
Renown.RvR.BotShare = 80
Renown.RvR.BotsPerWave = 15
Renown.RvR.BotsPerSide = 0

Renown.FieldMount.Enable = 1
Renown.FieldMount.Bots = 1
Renown.FieldMount.Speed = 30
Renown.FieldMount.MaxLevel = 39

Renown.Points.HonorableKill = 10
Renown.Points.KillingBlow = 5
Renown.Points.WorldKill = 10
Renown.Points.FlagCapture = 50
Renown.Points.FlagReturn = 20
Renown.Points.BaseAssault = 30
Renown.Points.BaseDefend = 20
Renown.Points.GraveyardAssault = 30
Renown.Points.GraveyardDefend = 20
Renown.Points.TowerAssault = 40
Renown.Points.TowerDefend = 30
Renown.Points.SecondaryObjective = 20
Renown.Points.Win = 100
Renown.Points.Loss = 40
Renown.Points.HealAssist = 5

Renown.InsigniaRanks = 5,10,15,20,25,30
Renown.InsigniaItems = 190520,190521,190522,190523,190524,190525
Renown.Quartermasters = 190100,190101
