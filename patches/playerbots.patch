+}
+
+// SPP Renown: the Renown module calls this for the bots it sends to fight on the Barrens Front. On the front they
+// stop questing and travelling (which made them wander off to Ratchet); when they leave it they get their usual
+// strategies back.
+bool RenownBotFrontMode(Player* bot, bool on)
+{
+    PlayerbotAI* ai = bot ? bot->GetPlayerbotAI() : nullptr;
+    if (!ai || !sRandomPlayerbotMgr.IsRandomBot(bot))
+        return false;
+
+    if (on)
+    {
+        if (ai->HasStrategy("travel", BotState::BOT_STATE_NON_COMBAT) || ai->HasStrategy("rpg", BotState::BOT_STATE_NON_COMBAT) ||
+            ai->HasStrategy("tfish", BotState::BOT_STATE_NON_COMBAT))
+            ai->ChangeStrategy("-travel,-rpg,-tfish", BotState::BOT_STATE_NON_COMBAT);
+        return true;
+    }
+
+    ai->ResetStrategies();
+    return true;
+}
