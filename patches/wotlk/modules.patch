+    void ModuleMgr::OnGetPlayerClassLevelInfo(Player* player, PlayerClassLevelInfo& info)
+    {
+        for (Module* mod : modules)
+        {
+            mod->OnGetPlayerClassLevelInfo(player, info);
+        }
+    }
+
+    void ModuleMgr::OnGetQuestXP(Player* player, const Quest* quest, uint32& xp)
+    {
+        for (Module* mod : modules)
+        {
+            mod->OnGetQuestXP(player, quest, xp);
+        }
+    }
+
+    bool ModuleMgr::OnPreBuyItem(Player* player, Creature* vendor, uint32 itemId, uint32 count, uint32& price)
+    {
+        bool handled = false;
+        for (Module* mod : modules)
+        {
+            if (mod->OnPreBuyItem(player, vendor, itemId, count, price))
+            {
+                handled = true;
+            }
+        }
+
+        return handled;
+    }
+
+    void ModuleMgr::OnBuyItem(Player* player, Creature* vendor, Item* item, uint32 count)
+    {
+        for (Module* mod : modules)
+        {
+            mod->OnBuyItem(player, vendor, item, count);
+        }
+    }
