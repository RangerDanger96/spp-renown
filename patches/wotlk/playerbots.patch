diff --git a/playerbot/RandomPlayerbotMgr.cpp b/playerbot/RandomPlayerbotMgr.cpp
index 3f32fd08..1970c614 100644
--- a/playerbot/RandomPlayerbotMgr.cpp
+++ b/playerbot/RandomPlayerbotMgr.cpp
@@ -3803,3 +3803,80 @@ float RandomPlayerbotMgr::GetMetricDelta(botPerformanceMetric& metric) const
 
     return deltaMetric / metric.size();
 }
+
+// SPP Renown: the Renown module calls this for the bots it sends to fight on the Barrens Front. On the front they
+// stop questing and travelling (which made them wander off to Ratchet); when they leave it they get their usual
+// strategies back.
+bool RenownBotFrontMode(Player* bot, bool on)
+{
+    PlayerbotAI* ai = bot ? bot->GetPlayerbotAI() : nullptr;
+    if (!ai || !sRandomPlayerbotMgr.IsRandomBot(bot))
+        return false;
+
+    if (on)
+    {
+        if (ai->HasStrategy("travel", BotState::BOT_STATE_NON_COMBAT) || ai->HasStrategy("rpg", BotState::BOT_STATE_NON_COMBAT) ||
+            ai->HasStrategy("tfish", BotState::BOT_STATE_NON_COMBAT))
+            ai->ChangeStrategy("-travel,-rpg,-tfish", BotState::BOT_STATE_NON_COMBAT);
+        return true;
+    }
+
+    ai->ResetStrategies();
+    return true;
+}
+
+// SPP Renown: warbands. A real player on the Barrens Front can call front bots into his party; they follow and fight
+// with him until he dismisses them or leaves the front.
+#include "Groups/Group.h"
+
+bool RenownBotJoinWarband(Player* bot, Player* leader)
+{
+    PlayerbotAI* ai = bot ? bot->GetPlayerbotAI() : nullptr;
+    if (!ai || !leader || !sRandomPlayerbotMgr.IsRandomBot(bot) || bot->GetGroup())
+        return false;
+
+    Group* group = leader->GetGroup();
+    if (!group)
+    {
+        group = new Group;
+        if (!group->Create(leader->GetObjectGuid(), leader->GetName()))
+        {
+            delete group;
+            return false;
+        }
+
+        sObjectMgr.AddGroup(group);
+    }
+
+    if (group->IsFull() || group->IsRaidGroup() || !group->AddMember(bot->GetObjectGuid(), bot->GetName()))
+        return false;
+
+    ai->SetMaster(leader);
+    ai->ResetStrategies();
+    // Stay at the leader's heels ("wander" lets them drift off and looks like standing around), and
+    // assist in combat: attack what the leader attacks or what attacks the party
+    ai->ChangeStrategy("-wander,+follow,+dps assist,-lfg,-bg,-travel,-rpg,-tfish,-grind", BotState::BOT_STATE_NON_COMBAT);
+    ai->ChangeStrategy("+dps assist,+pvp", BotState::BOT_STATE_COMBAT);
+    ai->Reset();
+    return true;
+}
+
+bool RenownBotLeaveWarband(Player* bot)
+{
+    PlayerbotAI* ai = bot ? bot->GetPlayerbotAI() : nullptr;
+    if (!ai)
+        return false;
+
+    if (Group* group = bot->GetGroup())
+    {
+        if (group->RemoveMember(bot->GetObjectGuid(), 0) <= 1)
+        {
+            // the group fell apart (only the leader left): RemoveMember already disbanded it
+        }
+    }
+
+    ai->SetMaster(nullptr);
+    ai->ResetStrategies();
+    ai->Reset();
+    return true;
+}
