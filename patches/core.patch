+// SPP Renown: fixed level brackets 1-9, 10-19, 20-29, 30-39, 40-49, 50-59, 60.
+// A battleground whose minimum level falls inside a bracket (Alterac Valley, 51) folds that partial
+// bracket into the next one, so Alterac Valley stays a single 51-60 bracket.
+static uint32 GetBracketForLevel(uint32 level)
+{
+    if (level < 10)
+        return BG_BRACKET_ID_FIRST;
+
+    uint32 bracket = level / 10;
+    return bracket > BG_BRACKET_ID_LAST ? uint32(BG_BRACKET_ID_LAST) : bracket;
+}
+
+static uint32 GetFirstBracketForBattleGround(BattleGround const* bg)
+{
+    uint32 minLevel = bg->GetMinLevel();
+    uint32 bracket = GetBracketForLevel(minLevel);
+    if (minLevel >= 10 && (minLevel % 10) != 0 && bracket < BG_BRACKET_ID_LAST)
+        ++bracket;
+
+    return bracket;
+}
+
 uint32 BattleGroundMgr::GetMinLevelForBattleGroundBracketId(BattleGroundBracketId bracket_id, BattleGroundTypeId bgTypeId) const
 {
-    if (bracket_id < 1)
-        return 0;
+    BattleGround* bg = GetBattleGroundTemplate(bgTypeId);
+    assert(bg);
+
+    if (bracket_id < BG_BRACKET_ID_FIRST)
+        bracket_id = BG_BRACKET_ID_FIRST;
 
     if (bracket_id > BG_BRACKET_ID_LAST)
         bracket_id = BG_BRACKET_ID_LAST;
 
-    BattleGround* bg = GetBattleGroundTemplate(bgTypeId);
-    assert(bg);
-    return 10 * bracket_id + bg->GetMinLevel();
+    if (uint32(bracket_id) <= GetFirstBracketForBattleGround(bg))
+        return std::max(bg->GetMinLevel(), 1u);
+
+    return 10 * uint32(bracket_id);
 }
 
-uint32 BattleGroundMgr::GetMaxLevelForBattleGroundBracketId(BattleGroundBracketId bracket_id, BattleGroundTypeId bgTypeId) const
+uint32 BattleGroundMgr::GetMaxLevelForBattleGroundBracketId(BattleGroundBracketId bracket_id, BattleGroundTypeId /*bgTypeId*/) const
 {
     if (bracket_id >= BG_BRACKET_ID_LAST)
-        return 255;                                         // hardcoded max level
+        return sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL);
+
+    if (bracket_id < BG_BRACKET_ID_FIRST)
+        bracket_id = BG_BRACKET_ID_FIRST;
 
-    return GetMinLevelForBattleGroundBracketId(bracket_id, bgTypeId) + 10;
+    return 10 * uint32(bracket_id) + 9;
 }
 
 BattleGroundBracketId BattleGroundMgr::GetBattleGroundBracketIdFromLevel(BattleGroundTypeId bgTypeId, uint32 playerLevel) const
 {
     BattleGround* bg = sBattleGroundMgr.GetBattleGroundTemplate(bgTypeId);
     assert(bg);
-    if (playerLevel < bg->GetMinLevel())
-        return BG_BRACKET_ID_FIRST;
-
-    uint32 bracket_id = (playerLevel - bg->GetMinLevel()) / 10;
-    if (bracket_id > MAX_BATTLEGROUND_BRACKETS)
-        return BG_BRACKET_ID_LAST;
 
+    uint32 bracket_id = std::max(GetBracketForLevel(playerLevel), GetFirstBracketForBattleGround(bg));
     return BattleGroundBracketId(bracket_id);
 }
