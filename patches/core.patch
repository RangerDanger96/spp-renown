+// SPP Renown: fixed level brackets 1-9, 10-19, 20-29, 30-39, 40-49, 50-59, 60.
+// A battleground whose minimum level falls inside a bracket (Alterac Valley, 51) folds that partial
+// bracket into the next one, so Alterac Valley stays a single 51-60 bracket.
+static uint32 GetBracketForLevel(uint32 level)
+{
+    if (level < 10)
+        return BG_BRACKET_ID_FIRST;
+
+    uint32 bracket = level / 10;
+    return bracket > BG_BRACKET_ID_LAST ? uint32(BG_BRACKET_ID_LAST) : bracket;
+}
+
+static uint32 GetFirstBracketForBattleGround(BattleGround const* bg)
+{
+    uint32 minLevel = bg->GetMinLevel();
+    uint32 bracket = GetBracketForLevel(minLevel);
+    if (minLevel >= 10 && (minLevel % 10) != 0 && bracket < BG_BRACKET_ID_LAST)
+        ++bracket;
+
+    return bracket;
+}
