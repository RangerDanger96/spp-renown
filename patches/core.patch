-    return 10 * bracket_id + bg->GetMinLevel();
+    if (uint32(bracket_id) <= GetFirstBracketForBattleGround(bg))
+        return std::max(bg->GetMinLevel(), 1u);
+
+    return 10 * uint32(bracket_id);
 }
 
